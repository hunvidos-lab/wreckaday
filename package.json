{
  "name": "wreckday",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps/mobile packages/contracts && prettier --check apps/mobile/app apps/mobile/src packages/contracts/src",
    "format": "prettier --write apps/mobile/app apps/mobile/src packages/contracts/src",
    "test": "pnpm --filter @wreckday/contracts test && vitest run apps/mobile/src/composer-model.test.ts",
    "web": "pnpm --filter mobile web"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0",
    "typescript": "6.0.3"
  }
}
