# Development server only. Copy to .env at repository root; never commit real keys.
# No generation or provider spending occurs until explicitly enabled and configured.
WRECKDAY_ENVIRONMENT=development
# pnpm dev enables the loopback console with a new Terminal-only password.
WRECKDAY_KEY_CONSOLE_ENABLED=false
WRECKDAY_LIVE_GENERATION_ENABLED=false
WRECKDAY_CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Public app configuration: base URL only. Never use EXPO_PUBLIC_ for API keys.
# Physical devices need a trusted reachable development-server address.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Llama through a chat-completions-compatible host (vLLM, Ollama or hosted service).
# Use the full /v1/chat/completions endpoint. HTTP is accepted only on loopback.
WRECKDAY_TEXT_ENDPOINT=
WRECKDAY_TEXT_API_KEY=
WRECKDAY_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Official FLUX.2 Klein 4B reference-image editing API:
WRECKDAY_IMAGE_PROVIDER=bfl
WRECKDAY_IMAGE_ENDPOINT=https://api.bfl.ai/v1/flux-2-klein-4b
WRECKDAY_IMAGE_API_KEY=
WRECKDAY_IMAGE_MODEL=flux-2-klein-4b

# Alternative: FLUX.2 Klein 4B edit via fal (inline sync_mode result, Authorization: Key ...):
# WRECKDAY_IMAGE_PROVIDER=fal
# WRECKDAY_IMAGE_ENDPOINT=https://fal.run/fal-ai/flux-2/klein/4b/edit

# Alternative: self-hosted/commercially licensed reference-image editing service.
# It must implement multipart /v1/images/edits and return data[0].b64_json.
# Point the endpoint at YOUR service implementing this contract; plain Diffusers,
# ComfyUI and arbitrary hosted providers are not automatically wire-compatible.
# WRECKDAY_IMAGE_PROVIDER=image_edits
# WRECKDAY_IMAGE_ENDPOINT=http://127.0.0.1:9000/v1/images/edits
# WRECKDAY_IMAGE_MODEL=Qwen/Qwen-Image-Edit

# Required explicit conservative ceilings, using YOUR provider's current quote.
# Blank cost values are intentionally unconfigured: set them before enabling.
# Text ceiling covers BOTH the review and planning requests for one story.
# Image ceiling covers ONE image edit. Per-story reservation = text + scenes*image.
# Zero cost is accepted for a genuinely zero-provider-fee local service.
# Optional cap per UTC day, on top of the session budget. Blank = no daily cap.
WRECKDAY_DAILY_BUDGET_USD=2
WRECKDAY_SESSION_BUDGET_USD=14
WRECKDAY_TEXT_COST_CEILING_USD=
WRECKDAY_IMAGE_COST_CEILING_USD=
WRECKDAY_MAX_GENERATION_REQUESTS=3
# Daily reservations and hashed IDs persist in work/generation-ledger.sqlite3 by default.
# All processes must share a ledger; never put this URL in EXPO_PUBLIC_.
# WRECKDAY_BUDGET_DATABASE_URL=postgresql+psycopg://user:password@localhost/wreckday_budget
# Session budget and request count remain per-process. This is NOT customer billing.

# Optional tariffs for other text hosts; both required to value measured tokens.
# The exact Cloudflare @cf/meta/llama-3.3-70b-instruct-fp8-fast model has verified defaults.
WRECKDAY_TEXT_INPUT_USD_PER_MILLION=
WRECKDAY_TEXT_OUTPUT_USD_PER_MILLION=
# Optional fal key with billing:usage:read. Otherwise the image key is tried.
# Permission failure/delayed events leave costs pending; they never retry inference.
WRECKDAY_FAL_BILLING_API_KEY=
