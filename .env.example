# Development fixtures only. Do not deploy this build publicly.
WRECKDAY_ENVIRONMENT=development
WRECKDAY_DEV_AUTH=true
WRECKDAY_DATABASE_URL=postgresql+psycopg://wreckday:local-only@127.0.0.1:55432/wreckday
WRECKDAY_STORAGE_ROOT=work/media
WRECKDAY_SIGNING_SECRET=development-only-never-deploy-this-key
WRECKDAY_PUBLIC_API_URL=http://localhost:8000
WRECKDAY_CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# For a physical device, both URLs must use the reachable development host IP.
EXPO_PUBLIC_API_URL=http://localhost:8000
# No image/text model, Supabase service-role, or payment secrets are needed.
