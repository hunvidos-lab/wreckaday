{
  "expo": {
    "name": "Wreckaday Studio Dev",
    "slug": "wreckday-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "invalid.example.wreckday.dev"
    },
    "android": {
      "package": "invalid.example.wreckday.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your reference photo. It is sent to the configured model providers only when you confirm and start generation.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "wreckday-dev"
  }
}
